// Places live in the database, not in a TypeScript file, so that adding a spot
// is a form submission rather than a code change and a redeploy.
//
// Dev runs on SQLite. Moving to Postgres is: change `provider` to "postgresql",
// point DATABASE_URL at the server, and re-run `prisma migrate dev`.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  // Postgres: change this to "postgresql" and generate a migration history for
  // it (see the deployment section of the README). The application code needs
  // no edit — src/lib/db.ts picks its adapter from DATABASE_URL.
  provider = "postgresql"
}

model Place {
  id         String @id @default(cuid())
  /// Stable, human-readable id used in URLs. Never reused.
  slug       String @unique
  category   String // spot | experience | restaurant
  areaKey    String
  prefecture String

  /// false = the long tail the service exists to surface.
  famous Boolean @default(false)

  lat         Float
  lng         Float
  stayMinutes Int
  crowd       String  @default("normal") // quiet | normal | busy
  indoor      Boolean @default(false)
  accessible  Boolean @default(true)
  openHour    Int     @default(9)
  closeHour   Int     @default(17)

  priceFrom          Int?
  bookable           Boolean @default(false)
  /// Our take on a booking made here, in percent of the gross. Negotiated per
  /// partner, so it lives on the record rather than in a constant.
  commissionPct      Int     @default(10)
  externalBookingUrl String?
  mealSlot           String? // lunch | dinner | any

  imageEmoji String @default("📍")
  imageFrom  String @default("#7c4dff")
  imageTo    String @default("#0e9cb8")

  seasonSpring Int @default(3)
  seasonSummer Int @default(3)
  seasonAutumn Int @default(3)
  seasonWinter Int @default(3)

  /// draft entries are invisible to travellers until an editor publishes them.
  status String @default("draft") // draft | published

  /// Freshness stamps: when this record was last confirmed, and against what.
  verifiedAt DateTime?
  source     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations PlaceTranslation[]
  tags         PlaceTag[]
  photos       PlacePhoto[]

  @@index([status, areaKey])
  @@index([status, category])
}

/// One row per language. Adding Korean is inserting rows, not altering a table.
model PlaceTranslation {
  id          String @id @default(cuid())
  placeId     String
  locale      String
  name        String
  description String
  area        String

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, locale])
  @@index([locale])
}

/// Interest tags as rows so "places tagged X" stays an indexed query at scale.
model PlaceTag {
  placeId String
  tag     String

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([placeId, tag])
  @@index([tag])
}

// ---------------------------------------------------------------- travellers
// Everything below used to live in a JSON file behind an async mutex. A single
// file cannot take concurrent writes, which is fine for a demo and wrong for a
// service where several people edit one itinerary at once.

model Trip {
  id       String @id @default(cuid())
  /// Unguessable segment in the invite link. Holding it grants edit rights.
  shareId  String @unique
  title    String
  ownerLabel String
  days     Int    @default(2)
  stamina  String @default("standard")
  accessibleOnly Boolean @default(false)
  startHour Int   @default(9)
  locale   String @default("en")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stops TripStop[]
  notes TripNote[]
}

/// Ordered, because the shortlist order is what the planner starts from.
model TripStop {
  id        String @id @default(cuid())
  tripId    String
  placeSlug String
  position  Int

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, placeSlug])
  @@index([tripId, position])
}

model TripNote {
  id        String   @id @default(cuid())
  tripId    String
  author    String
  body      String
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, createdAt])
}

model Booking {
  id          String   @id @default(cuid())
  reference   String   @unique
  placeSlug   String
  travellerId String
  date        String
  time        String
  partySize   Int
  name        String
  email       String
  requests    String   @default("")
  totalJpy    Int      @default(0)
  /// Our earnings on this booking, frozen at the rate in force when it was
  /// made. Recomputing later from the place would silently rewrite history.
  commissionJpy Int    @default(0)
  /// paid | uncollected. Uncollected means no payment provider was configured
  /// when this was taken — it is a demo record, not a sale.
  paymentStatus String  @default("uncollected")
  paymentRef    String?
  createdAt   DateTime @default(now())

  @@index([travellerId, createdAt])
}

model Order {
  id          String @id @default(cuid())
  reference   String @unique
  travellerId String
  productId   String
  quantity    Int
  mode        String
  pickupPointId      String?
  destinationCountry String?
  hotelName          String?
  name        String
  email       String
  itemJpy     Int
  feeJpy      Int
  totalJpy    Int
  /// Our cut. What a real payout run would settle against.
  commissionJpy Int
  partnerName String
  etaDays     Int
  /// paid | uncollected. See Booking.paymentStatus.
  paymentStatus String  @default("uncollected")
  paymentRef    String?
  createdAt   DateTime @default(now())

  @@index([travellerId, createdAt])
}

model Visit {
  travellerId String
  placeSlug   String
  visitedAt   DateTime @default(now())

  @@id([travellerId, placeSlug])
  @@index([travellerId])
}

// ------------------------------------------------------------------ editors
// A shared password told us that *someone* authorised was editing. With several
// people adding places at once, the catalogue needs to record which one.

model Editor {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  /// scrypt$salt$key. Never a plaintext or unsalted digest.
  passwordHash String
  /// admin can manage editors and delete places; editor can do neither.
  role         String  @default("editor")
  /// disabled keeps the audit trail intact where deleting the row would not.
  status       String  @default("active")

  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  sessions  EditorSession[]
  revisions PlaceRevision[]
}

/// Sessions live in the database so disabling an account ends it immediately.
model EditorSession {
  id String @id @default(cuid())
  /// SHA-256 of the cookie value. A dump of this table grants no logins.
  tokenHash String   @unique
  editorId  String
  createdAt DateTime @default(now())
  expiresAt DateTime

  editor Editor @relation(fields: [editorId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// Who changed what, and when. Append-only.
model PlaceRevision {
  id        String @id @default(cuid())
  placeSlug String
  /// create | update | publish | unpublish | delete
  action    String
  /// Human-readable list of what actually changed.
  summary   String

  editorId String?
  /// Denormalised so history stays readable if the account is ever removed.
  editorEmail String

  createdAt DateTime @default(now())

  editor Editor? @relation(fields: [editorId], references: [id], onDelete: SetNull)

  @@index([placeSlug, createdAt])
  @@index([createdAt])
}

/// Photographs. A place without any still renders from its emoji and gradient,
/// which is what keeps a half-finished entry presentable rather than broken.
model PlacePhoto {
  id      String @id @default(cuid())
  placeId String
  /// Public URL from the storage adapter — a local path in dev, a CDN URL in
  /// production. Never a path the browser resolves against the filesystem.
  url     String
  /// Written in the default locale. Required: a photo nobody can describe is
  /// not usable by a screen reader, and travel content is mostly photographs.
  alt     String
  /// Who took it. Most usable travel photography is licensed, not owned.
  credit    String  @default("")
  creditUrl String?
  /// 0 is the hero shown on cards and at the top of the detail page.
  position  Int     @default(0)

  /// Set only by the local-disk adapter, so deleting a photo can delete a file.
  storageKey String?

  createdAt DateTime @default(now())

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId, position])
}

// ------------------------------------------------------------------ revenue
// Three ways this service earns: a take on bookings it handles, a commission on
// merchandise a partner ships, and affiliate referrals it hands off. Only the
// second was modelled. The other two are below, because revenue you cannot
// count is revenue you cannot invoice.

/// Every hand-off to a partner. The evidence behind an affiliate invoice, and
/// the only way to tell which partners are worth the shelf space.
model PartnerClick {
  id          String @id @default(cuid())
  travellerId String
  /// flight | hotel | place-booking | support | shop
  surface     String
  partnerId   String
  partnerName String
  /// Offer id or place slug — whatever identifies what was clicked.
  targetRef   String
  /// Destination host, so a report can group by partner domain.
  targetHost  String
  locale      String
  placeSlug   String?
  /// What the click is worth if it converts, at the partner's stated rate.
  /// A forecast, never an invoice: only the partner knows what actually sold.
  estimatedValueJpy Int @default(0)

  /// YYYY-MM-DD in JST, written at insert. Grouping a timestamp by local day
  /// needs database-specific SQL; a column does not, and it is indexable.
  day       String
  createdAt DateTime @default(now())

  @@index([day])
  @@index([createdAt])
  @@index([partnerId, createdAt])
  @@index([surface, createdAt])
}

/// Daily rollup per place, upserted on the write path. The partner console and
/// the revenue console both read this one small indexed table rather than
/// scanning raw events, which is what keeps them honest and fast at once.
model PlaceDailyStat {
  placeSlug String
  /// YYYY-MM-DD in JST — the day a Japanese partner would recognise.
  day       String

  views         Int @default(0)
  partnerClicks Int @default(0)
  bookings      Int @default(0)
  orders        Int @default(0)
  /// Gross transacted through us. Not our earnings.
  grossJpy      Int @default(0)
  /// Our cut of that gross.
  commissionJpy Int @default(0)

  @@id([placeSlug, day])
  @@index([day])
}
