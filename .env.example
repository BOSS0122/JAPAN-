# Local SQLite file. For production point this at Postgres and change the
# provider in prisma/schema.prisma.
DATABASE_URL="file:./prisma/dev.db"

# Where uploaded photos are stored. "local" writes into public/uploads/places,
# which is fine for development and a single box. Register an S3/R2 adapter in
# src/lib/storage/index.ts and set this to its key for anything else.
IMAGE_STORAGE="local"
