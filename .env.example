# ---------------------------------------------------------------- database
# Production and local development both run PostgreSQL, so that a migration
# that works locally is the same migration that runs in production. The
# committed migration history in prisma/migrations is PostgreSQL.
#
# For zero-setup local work you can use SQLite instead: change `provider` in
# prisma/schema.prisma to "sqlite", point this at a file, and use
# `npx prisma db push` rather than migrate — the driver is chosen from this URL,
# so no application code changes. Do not commit that schema edit.
DATABASE_URL="postgresql://user:password@localhost:5432/japanquest"

# ------------------------------------------------------------------ secrets
# Signs partner hand-off links so /api/go can never be used as an open
# redirect. REQUIRED in production — the app refuses to start without it.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LINK_SECRET=""

# ---------------------------------------------------------------- public URL
# Public origin, no trailing slash. Canonical URLs, hreflang and the sitemap
# are omitted rather than guessed when this is unset.
SITE_URL=""

# --------------------------------------------------------------- integrations
# Where uploaded photos are stored. "local" writes into public/uploads/places,
# which is right for development and a single box. Register an S3/R2 adapter in
# src/lib/storage/index.ts and set this to its key for anything else.
IMAGE_STORAGE="local"

# Swap in a real provider once the partner contract is signed. See
# src/lib/providers/index.ts.
FLIGHT_PROVIDER="mock"
HOTEL_PROVIDER="mock"
FULFILLMENT_PROVIDER="mock"

# ------------------------------------------------------------------ launch
# The traveller site is closed to the public until this is exactly "true".
# Unpublished is the default on purpose: a misconfigured deploy should show a
# holding page, never a half-finished shop. Signed-in editors always see the
# real site, so the catalogue can be filled before launch.
LAUNCHED="false"

# ----------------------------------------------------------------- payments
# "none" until a processor is wired in. While the site is unpublished, paid
# transactions are recorded as uncollected and marked as such in the console.
# Once LAUNCHED=true, a paid transaction with no live provider is refused —
# telling a traveller they bought something they did not is not a demo detail.
PAYMENT_PROVIDER="none"
